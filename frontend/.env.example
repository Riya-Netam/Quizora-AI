# Leave empty to call the API on the same origin (recommended: Vite proxy in dev, Vercel rewrite in production).
# Set to your API origin (no trailing slash, no /api/v1), e.g. https://quizora-api.onrender.com, to call it directly.
# Direct calls also need CORS on the backend and COOKIE_SAMESITE=none with COOKIE_SECURE=true.
VITE_API_BASE_URL=
