# --- Environment ---
ENVIRONMENT=development            # development | production | test
DEBUG=false

# --- Database ---
# Local quick start (SQLite, dev only):  sqlite:///./quizora_dev.db
# Production (Supabase):  postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./quizora_dev.db

# --- Auth ---
JWT_SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false                # must be true in production (HTTPS)
COOKIE_SAMESITE=lax                # "none" only if frontend/API are on different sites (needs COOKIE_SECURE=true)

# --- CORS / URLs ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Admin bootstrap (used by: python -m app.cli create-admin) ---
ADMIN_EMAIL=admin@example.com

# --- AI ---
AI_PROVIDER=gemini                 # gemini | demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_DAILY_LIMIT_PER_USER=10
AI_MAX_QUESTIONS=30
AI_MAX_INPUT_CHARS=30000

# --- Uploads ---
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=60

# --- Email (optional; leave blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

ENABLE_API_DOCS=true
